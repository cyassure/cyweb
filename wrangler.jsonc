{
  // Static SPA with a small Worker backing /api/*. `run_worker_first` scopes
  // the Worker to that one route prefix — every other request is still
  // served straight from static assets, unchanged from the original
  // pure-static deploy.
  //
  // Explicit config so `wrangler deploy` skips framework auto-detection,
  // which otherwise requires Vite 6+ (this project is on Vite 5).
  //
  // Cloudflare's dashboard "Framework preset" (set when the project was
  // connected) can override this and force the Vite auto-config path
  // anyway — if deploys still fail with the Vite-6 error, go to
  // Workers & Pages > cyweb > Settings > Build and set Framework preset
  // to "None", so wrangler actually reads this file instead of guessing.
  "name": "cyweb",
  "compatibility_date": "2026-08-09",
  "main": "./worker/index.ts",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cyweb-registrations",
      "database_id": "23259db0-46c3-4fc4-a152-a7dfe7809b06"
    }
  ]
  // Verification emails send via Microsoft Graph (existing M365 tenant),
  // not Cloudflare Email Sending (that needs Workers Paid). Credentials are
  // Worker secrets — MS_GRAPH_TENANT_ID, MS_GRAPH_CLIENT_ID,
  // MS_GRAPH_CLIENT_SECRET, MS_GRAPH_SENDER — set via `wrangler secret put`,
  // not config here. See worker/env.d.ts.
}
