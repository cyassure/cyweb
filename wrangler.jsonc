{
  // Pure static SPA deploy — no Worker code, no server-side rendering.
  // Explicit config so `wrangler deploy` skips framework auto-detection,
  // which otherwise requires Vite 6+ (this project is on Vite 5).
  "name": "cyweb",
  "compatibility_date": "2026-08-09",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
