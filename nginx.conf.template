server {
    listen 80;
    root /usr/share/nginx/html;
    index index.html;

    # ── Marketplace catalog — open access ─────────────────────────────────────
    # catalog.json contains public information only (integration names, icons,
    # playbook descriptions). CORS is locked to the known portal origin to
    # prevent direct browser cross-origin fetches; the actual catalog data is
    # non-sensitive and served to all licensed cycentra360 instances.
    location /marketplace/ {
        add_header Access-Control-Allow-Origin "${FRONTEND_URL}" always;
        add_header Access-Control-Allow-Methods "GET, OPTIONS" always;
        add_header Cache-Control "no-store" always;
    }

    # ── SPA routing ────────────────────────────────────────────────────────────
    location / {
        try_files $uri $uri/ /index.html;
    }

    # ── Security headers ───────────────────────────────────────────────────────
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
}
