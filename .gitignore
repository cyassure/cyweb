# Legacy package manager artifact — this project uses npm (see package-lock.json).
# A committed bun.lockb makes Cloudflare Pages auto-detect bun and fail install.
bun.lockb
bun.lock

# Ignore top-level docs folder (internal notes) — but not src/content/docs,
# which is real site content bundled into the built app.
/docs/
!src/content/docs/
